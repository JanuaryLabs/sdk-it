{
  "name": "@sdk-it/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .husky || exit 0",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "npm run test:packages",
    "test:packages": "nx run-many -t test",
    "test:e2e": "bun ./e2e/index.ts",
    "test:e2e:dart": "bun ./e2e/dart.ts",
    "build": "nx run-many -t build",
    "check:data": "node tools/check-data-files.mjs",
    "check:links": "node tools/check-markdown-links.mjs"
  },
  "repository": "https://github.com/JanuaryLabs/sdk-it",
  "private": true,
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@nx/esbuild": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/vite": "24.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/libnpmpublish": "^9.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@zukhruf/eslint": "^0.8.12",
    "@zukhruf/git-hooks": "^0.8.10",
    "@zukhruf/testing": "^0.8.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "evlog": "^2.34.0",
    "jsonc-eslint-parser": "^2.4.0",
    "nx": "24.0.3",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "verdaccio": "6.1.4",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "config": ".verdaccio/config.yml",
          "port": 4873,
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "@types/pluralize": "^0.0.33",
    "ai": "^7.0.162",
    "hono": "^4.8.3",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": false,
    "nx": false,
    "unrs-resolver": false,
    "@swc/core": false,
    "@tailwindcss/oxide": false
  }
}
