# Strict peers fail with ERESOLVE: evlog 2.34.0 (a test-only dependency) has the
# optional peers react-router@>=7.18.4, express@>=5.3.0 and hono@>=4.13.13, and
# the tree holds react-router 7.18.1 (apiref's @react-router/* pin it),
# express 4.21.2 and hono 4.12.30. Set false once those meet (#4511).
legacy-peer-deps=true
# An install fails when a dependency has an install script that allowScripts
# in package.json does not name, so no script is skipped without a review.
strict-allow-scripts=true
