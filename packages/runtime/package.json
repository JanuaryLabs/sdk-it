{
  "name": "@sdk-it/runtime",
  "version": "0.50.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/sdk-it",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/sdk-it/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/sdk-it/tree/main/packages/runtime#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
