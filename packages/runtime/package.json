  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "fast-content-type-parse": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sdk-it/testing": "*"
  }
