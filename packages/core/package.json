{
  "name": "@sdk-it/core",
  "version": "0.47.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/sdk-it",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/sdk-it/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/sdk-it/tree/main/packages/core#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*",
      "import": "./dist/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@zukhruf/fs": "^0.8.33",
    "stringcase": "^4.3.1"
  },
  "peerDependencies": {
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "openapi3-ts": "^4.6.2",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@typescript/native": {
      "optional": true
    },
    "openapi3-ts": {
      "optional": true
    }
  }
}
