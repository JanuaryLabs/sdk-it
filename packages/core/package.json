{
  "name": "@sdk-it/core",
  "version": "0.46.11",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*",
      "import": "./dist/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@zukhruf/fs": "^0.6.15",
    "stringcase": "^4.3.1"
  },
  "peerDependencies": {
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "openapi3-ts": "^4.6.2",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@typescript/native": {
      "optional": true
    },
    "openapi3-ts": {
      "optional": true
    }
  }
}
