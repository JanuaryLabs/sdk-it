    "commander": "^13.1.0",
    "@sdk-it/core": "0.51.9",
    "@sdk-it/openapi": "0.51.9",
    "libnpmpublish": "^11.0.0",
    "openapi3-ts": "4.6.2",
    "registry-auth-token": "^5.1.0",
    "@sdk-it/python": "0.51.9",
    "@sdk-it/readme": "0.51.9",
    "zod": "^4.6.7",
