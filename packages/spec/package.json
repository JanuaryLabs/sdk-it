{
  "name": "@sdk-it/spec",
  "version": "0.46.11",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*",
      "import": "./dist/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@sdk-it/core": "0.46.11",
    "@zukhruf/async": "^0.8.10",
    "@zukhruf/fs": "^0.8.10",
    "lodash-es": "^4.17.21",
    "micromatch": "4.0.8",
    "openapi3-ts": "4.6.2",
    "p-limit": "3.1.0",
    "pluralize": "^8.0.0",
    "stringcase": "^4.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@sdk-it/testing": "*"
  }
}
