{
  "name": "@sdk-it/hono",
  "version": "0.46.11",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": {
        "@sdk-it/source": "./src/lib/runtime/index.ts",
        "default": "./dist/lib/runtime/index.d.ts"
      },
      "import": "./dist/lib/runtime/index.js",
      "default": "./dist/lib/runtime/index.js"
    },
    "./evlog": {
      "types": "./dist/lib/evlog.d.ts",
      "import": "./dist/lib/evlog.js",
      "default": "./dist/lib/evlog.js"
    }
  },
  "files": [
    "dist",
    "src/lib/runtime",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@sdk-it/core": "0.46.11",
    "hono": "^4.7.4",
    "zod": "^4.6.7",
    "fast-content-type-parse": "^3.0.0"
  },
  "peerDependencies": {
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "openapi3-ts": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@typescript/native": {
      "optional": true
    },
    "openapi3-ts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/debug": "^4.1.12"
  }
}
