{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build-types",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "targetDefaults": {
    "@nx/esbuild:esbuild": {
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "format": ["esm"],
        "declaration": false,
        "skipTypeCheck": true,
        "deleteOutputPath": false,
        "minify": false,
        "sourcemap": true,
        "external": [
          "@sdk-it/readme",
          "@sdk-it/core",
          "@sdk-it/spec",
          "@sdk-it/typescript",
          "@sdk-it/dart",
          "@sdk-it/cli",
          "@sdk-it/command",
          "@sdk-it/generic",
          "@sdk-it/hono",
          "@sdk-it/rpc",
          "@sdk-it/runtime"
        ]
      },
      "cache": true,
      "dependsOn": ["^build", "build-types"],
      "inputs": ["production", "^production"]
    }
  },
  "release": {
    "conventionalCommits": {
      "types": {
        "chore": {
          "changelog": {
            "hidden": true
          }
        },
        "refactor": {
          "semverBump": "patch"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": false
      }
    },
    "version": {
      "preVersionCommand": "NX_DAEMON=false npx nx run-many -t build --prod --exclude apiref && npm run test:e2e",
      "conventionalCommits": true
    },
    "releaseTag": {
      "pattern": "release/{version}"
    }
  },
  "sync": {
    "applyChanges": true
  },
  "analytics": false,
  "affected": {
    "legacy": true
  }
}
